{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run compress",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceRoot}/code/compiled/main",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Compile main.c",
      "args": [
        "compress",
        "${workspaceRoot}/data/entrada.txt"
      ]
    },
    {
      "name": "Run decompress",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceRoot}/code/compiled/main",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Compile main.c",
      "args": [
        "decompress",
        "${workspaceRoot}/data/entrada.txt"
      ]
    }
  ]
}